#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_ja.h"

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        bs {
            bindings = <&kp BACKSPACE>;
            key-positions = <18 19>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <30 31>;
            layers = <0>;
        };

        henkan {
            bindings = <&kp LA(GRAVE)>;
            key-positions = <6 7>;
            layers = <0>;
        };

        iko-ru {
            bindings = <&kp LS(MINUS)>;
            key-positions = <41 18>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        p: password {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N1 &kp Q &kp A &kp Z &kp N2 &kp W &kp S &kp X &kp LS(MINUS) &kp LS(LBKT) &kp LS(SQT) &kp LS(INT1)>;
            label = "PASSWORD";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        Rctl: Rctl {
            compatible = "zmk,behavior-tap-dance";
            label = "RCTL";
            #binding-cells = <0>;
            bindings = <&mo 7>, <&kp RCTRL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp J         &kp U         &kp COMMA                    &kp PERIOD                                                            &kp F                  &kp W  &kp R  &kp Y  &kp P
&kp E    &kp I         &kp A         &kp O                        &kp MINUS             &kp LS(LG(S))                    &p             &kp K                  &kp T  &kp N  &kp S  &kp H
&kp X    &kp L         &kp C         &kp V                        &kp SLASH             &kp COLON                        &kp SEMICOLON  &kp G                  &kp D  &kp M  &kp Z  &kp B
&kp ESC  &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 5 INT_HENKAN  &mt LEFT_SHIFT ENTER  &lt_to_layer_0 6 LEFT_SHIFT      &Rctl          &mt RIGHT_SHIFT SPACE                       &none
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            bindings = <
&none  &none  &none  &none  &none                    &none  &kp F1  &kp F2  &kp F3  &kp F10
&none  &none  &none  &none  &none  &none      &none  &none  &kp F4  &kp F5  &kp F6  &kp F11
&none  &none  &none  &none  &none  &none      &none  &none  &kp F7  &kp F8  &kp F9  &kp F12
&none  &none  &none  &none  &none  &none      &none  &none                          &none
            >;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                   &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans                       &trans          &trans                                                                     &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&none  &none  &kp LC(F)  &kp LC(C)  &kp LC(X)                    &none  &none     &none     &none     &none
&none  &none  &kp LC(A)  &kp LC(V)  &none      &none      &none  &none  &mkp MB1  &mkp MB3  &mkp MB2  &to 0
&none  &none  &none      &kp LC(X)  &none      &none      &none  &none  &none     &none     &none     &none
&none  &none  &none      &to 0      &to 0      &to 0      &mo 7  &to 0                                &none
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        kigou {
            bindings = <
&trans         &kp LS(LG(S))   &mo 9   &trans  &trans                      &kp EQUAL  &kp EXCLAMATION  &kp HASH       &kp QUESTION          &trans
&trans         &trans          &mo 9   &mo 8   &trans  &trans      &trans  &kp TILDE  &kp LBKT         &kp SQT        &kp NON_US_BACKSLASH  &trans
&trans         &trans          &trans  &mo 1   &trans  &trans      &trans  &trans     &kp AMPERSAND    &kp SEMICOLON  &kp LS(INT1)          &trans
&kp LS(LG(G))  &kp LG(PERIOD)  &trans  &trans  &trans  &trans      &trans  &kp SPACE                                                        &trans
            >;
        };

        layer_7 {
            bindings = <
&kp LS(PLUS)  &kp N1  &kp N2  &kp N3  &kp COMMA                          &trans  &trans          &kp UP_ARROW  &trans     &trans
&kp LS(STAR)  &kp N4  &kp N5  &kp N6  &kp MINUS      &trans      &trans  &trans  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &trans
&kp FSLH      &kp N7  &kp N8  &kp N9  &kp LS(EQUAL)  &trans      &trans  &trans  &trans          &trans        &trans     &trans
&trans        &trans  &trans  &trans  &kp N0         &trans      &trans  &trans                                           &trans
            >;
        };

        NUM-2 {
            bindings = <
&none  &none  &none  &none  &none                    &none      &kp N1  &kp N2  &kp N3  &kp LS(SEMI)
&none  &none  &none  &none  &none  &none      &none  &kp MINUS  &kp N4  &kp N5  &kp N6  &kp LS(SQT)
&none  &none  &none  &none  &none  &none      &none  &none      &kp N7  &kp N8  &kp N9  &kp FSLH
&none  &none  &none  &none  &none  &none      &none  &kp N0                             &none
            >;
        };

        kakko {
            bindings = <
&none  &none  &none  &none  &none                    &none  &kp LS(LPAR)  &kp LS(N7)    &kp LS(RPAR)  &none
&none  &none  &none  &none  &none  &none      &none  &none  &kp RBKT      &kp LS(N2)    &kp BSLH      &none
&none  &none  &none  &none  &none  &none      &none  &none  &kp LS(RBKT)  &kp LS(LBKT)  &kp LS(BSLH)  &none
&none  &none  &none  &none  &none  &none      &none  &none                                            &none
            >;
        };
    };
};
