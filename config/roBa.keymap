#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_ja.h"

/* Layers:
 * 0 default, 1 FUNCTION, 2 NUM, 3 ARROW, 4 MOUSE,
 * 5 scroll/BT (hold the 変換 thumb), 6 kigou, 7 layer_7, 8 NUM-2, 9 kakko.
 *
 * Symbol keys use keys_ja.h so a JIS OS layout produces the named character.
 * Number keys on symbol/num layers are keypad codes (KP_N0..KP_N9).
 */

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";

        bs {
            bindings = <&kp BACKSPACE>;
            key-positions = <18 19>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <30 31>;
            layers = <0>;
        };

        henkan {
            bindings = <&kp LA(GRAVE)>;
            key-positions = <6 7>;
            layers = <0>;
        };

        iko-ru {
            bindings = <&kp JP_EQUAL>;
            key-positions = <41 18>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        p: password {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N1 &kp Q &kp A &kp Z &kp N2 &kp W &kp S &kp X &kp LS(MINUS) &kp LS(LBKT) &kp LS(SQT) &kp LS(INT1)>;
            label = "PASSWORD";
        };

        /* Win+Shift+S. Release S before the modifiers so the Start menu does not open. */
        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LSHFT &kp S>
                , <&macro_pause_for_release>
                , <&macro_release &kp S &kp LSHFT &kp LGUI>;
        };

        /* Two left clicks. 30ms down, 40ms gap: inside the usual Windows double-click time. */
        dblclk: double_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            wait-ms = <40>;
            bindings = <&mkp LCLK &mkp LCLK>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        Rctl: Rctl {
            compatible = "zmk,behavior-tap-dance";
            label = "RCTL";
            #binding-cells = <0>;
            bindings = <&mo 7>, <&kp RCTRL>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp J         &kp U         &kp COMMA                    &kp PERIOD                                                            &kp F        &kp W  &kp R  &kp Y  &kp P
&kp E    &kp I         &kp A         &kp O                        &kp MINUS             &screenshot                      &p           &kp K        &kp T  &kp N  &kp S  &kp H
&kp X    &kp L         &kp C         &kp V                        &kp SLASH             &kp JP_COLON                     &kp SEMICOLON &kp G       &kp D  &kp M  &kp Z  &kp B
&kp ESC  &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 5 INT_HENKAN  &mt LEFT_SHIFT ENTER  &lt_to_layer_0 6 LEFT_SHIFT      &Rctl        &mt RIGHT_SHIFT SPACE                 &tog 4
            >;

            /* Left encoder: clockwise zooms in, the other way zooms out.
             * On a JIS layout the ;+ key is VK_OEM_PLUS, so Ctrl+; is Ctrl+Plus.
             * Ctrl+- is the same minus key. Swap the two codes if the direction is reversed.
             */
            sensor-bindings = <&inc_dec_kp LC(JP_SEMI) LC(JP_MINUS)>;
        };

        FUNCTION {
            bindings = <
&none  &none  &none  &none  &none                    &none  &kp F1  &kp F2  &kp F3  &kp F10
&none  &none  &none  &none  &none  &none      &none  &none  &kp F4  &kp F5  &kp F6  &kp F11
&none  &none  &none  &none  &none  &none      &none  &none  &kp F7  &kp F8  &kp F9  &kp F12
&none  &none  &none  &none  &none  &none      &none  &none                          &none
            >;
        };

        NUM {
            bindings = <
&kp JP_MINUS        &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp JP_PLUS                                              &kp JP_CARET  &kp JP_AMPS  &kp JP_TILDE  &kp JP_LPAR  &kp JP_RPAR
&kp JP_FSLH         &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp JP_ASTRK  &kp LC(LA(KP_N0))      &kp JP_UNDER  &kp JP_EXCL  &kp JP_AT    &kp JP_HASH   &kp JP_DLLR  &kp JP_PRCNT
&mt LEFT_SHIFT KP_N0 &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp JP_DOT    &kp JP_EQUAL           &trans        &kp JP_LBKT  &kp JP_RBKT  &kp JP_LBRC   &kp JP_RBRC  &kp JP_BSLH
&trans              &trans     &trans     &trans     &trans        &trans                 &trans        &trans                                           &kp JP_PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        /* Right home row: back, left click, middle click (held while the key is down), right click.
         * Copy and paste are swapped: the comma key is paste, the O key is copy.
         * Double-click is directly under left click.
         * Hold the 変換 thumb to scroll. Enter is the enter thumb.
         * The right-edge key toggles this layer.
         */
        MOUSE {
            bindings = <
&none  &none  &kp LC(F)  &kp LC(V)  &kp LC(X)                         &none      &none      &none              &none     &none
&none  &none  &kp LC(A)  &kp LC(C)  &none           &screenshot       &none      &mkp MB4   &mkp LCLK          &mkp MCLK  &mkp RCLK  &to 0
&none  &none  &none      &kp LC(X)  &none           &none             &none      &none      &dblclk            &none               &none      &none
&none  &none  &none      &mo 5      &kp ENTER       &to 0             &mo 7      &to 0                                             &tog 4
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp KP_N1     &kp KP_N2     &kp KP_N3     &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        kigou {
            bindings = <
&trans         &screenshot     &mo 9   &trans  &trans                      &kp JP_EQUAL  &kp JP_EXCL  &kp JP_HASH  &kp JP_QMARK  &trans
&trans         &trans          &mo 9   &mo 8   &trans  &trans      &trans  &kp JP_TILDE  &kp JP_LBKT  &kp JP_SQT   &kp JP_BSLH   &trans
&trans         &trans          &trans  &mo 1   &trans  &trans      &trans  &trans        &kp JP_AMPS  &kp JP_SEMI  &kp JP_UNDER  &trans
&kp LS(LG(G))  &kp LG(PERIOD)  &trans  &trans  &trans  &trans      &trans  &kp SPACE                                         &trans
            >;
        };

        layer_7 {
            bindings = <
&kp JP_PLUS   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp JP_COMMA                            &trans  &trans          &kp UP_ARROW  &trans     &trans
&kp JP_ASTRK  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp JP_MINUS       &trans      &trans  &trans  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &trans
&kp JP_FSLH   &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp JP_EQUAL       &trans      &trans  &trans  &trans          &trans        &trans     &trans
&trans        &trans     &trans     &trans     &kp KP_N0          &trans      &trans  &trans                                           &trans
            >;
        };

        NUM-2 {
            bindings = <
&none  &none  &none  &none  &none                    &none         &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp JP_COLON
&none  &none  &none  &none  &none  &none      &none  &kp JP_MINUS  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp JP_DQT
&none  &none  &none  &none  &none  &none      &none  &none         &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp JP_FSLH
&none  &none  &none  &none  &none  &none      &none  &kp KP_N0                                &none
            >;
        };

        kakko {
            bindings = <
&none  &none  &none  &none  &none                    &none  &kp JP_LPAR  &kp JP_SQT    &kp JP_RPAR  &none
&none  &none  &none  &none  &none  &none      &none  &none  &kp JP_LBKT  &kp JP_DQT    &kp JP_RBKT  &none
&none  &none  &none  &none  &none  &none      &none  &none  &kp JP_LBRC  &kp JP_GRAVE  &kp JP_RBRC  &none
&none  &none  &none  &none  &none  &none      &none  &none                                         &none
            >;
        };

    };
};
